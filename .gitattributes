# Normalize repository-owned text files to LF
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve the clean-room archive byte-for-byte so SHA256SUMS.txt remains valid
archive/** -text

# Binary assets and packages
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.unitypackage binary
*.zip binary
