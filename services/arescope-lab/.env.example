# Supply two different, independently generated secrets. Empty values fail closed.
ARESCOPE_LIVE_PRODUCER_TOKEN=
ARESCOPE_LIVE_VIEWER_TOKEN=
ARESCOPE_LIVE_DB=/var/lib/arescope-lab/live.sqlite3
ARESCOPE_MESH_DIR=/var/lib/arescope-lab/meshes
ARESCOPE_LOG_DIR=/var/lib/arescope-lab/logs
ARESCOPE_SESSION_GAP=60
ARESCOPE_RETENTION_DAYS=7
ARESCOPE_MAX_DB_BYTES=209715200
ARESCOPE_MIN_HISTORY_INTERVAL=0.25
ARESCOPE_MAX_FRAMES_PER_SESSION=2000
ARESCOPE_MAX_EXPORT_POINTS=400000
ARESCOPE_MAX_MESH_BYTES=33554432
ARESCOPE_MAX_LOG_BYTES=8388608
