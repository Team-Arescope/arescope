# Generate TWO different secrets, for example with secrets.token_urlsafe(32).
# Empty values deliberately refuse startup. Never commit an actual .env file.
ARESCOPE_COPILOT_TOKEN=
ARESCOPE_DEVICE_TOKEN=

# Server-only key. Without it, settings work and upstream calls fail closed.
OMNIROUTE_API_KEY=
ARESCOPE_ROUTER_URL=http://127.0.0.1:20128/v1
ARESCOPE_SETTINGS_DB=~/.local/share/arescope-copilot/settings.sqlite3

# Comma-separated HTTP(S) origins, without trailing slashes or paths.
# Empty rejects every request that carries an Origin header.
ARESCOPE_ALLOWED_ORIGINS=
