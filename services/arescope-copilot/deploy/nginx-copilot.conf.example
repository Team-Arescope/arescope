# Include these locations in an existing TLS server block (listen 443 ssl).
# TLS certificates and server_name belong to that site's server configuration.
# Keep ARESCOPE_ALLOWED_ORIGINS in sync with the panel's exact browser origin.
# Use a dedicated vhost, or review these locations alongside existing routes.

location = /healthz {
    proxy_pass http://127.0.0.1:18975;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_connect_timeout 10s;
    proxy_read_timeout 10s;
    access_log off;
}

location ^~ /api/copilot/ {
    proxy_pass http://127.0.0.1:18975;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "";
    client_max_body_size 8m;
    client_body_timeout 60s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 100s;
    proxy_read_timeout 100s;
    send_timeout 100s;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    access_log off;
}
